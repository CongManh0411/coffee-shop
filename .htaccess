RewriteEngine On
RewriteBase /coffee-shop/

# Send legacy page URLs through the PHP front controller.
RewriteRule ^Login\.html$ admin/index.php?page=login [R=302,L,NC]
RewriteRule ^TableManage\.html$ admin/index.php?page=tablemanage [R=302,L,NC]
RewriteRule ^Menu\.html$ admin/index.php?page=menu [R=302,L,NC]
RewriteRule ^Revenue\.html$ admin/index.php?page=revenue [R=302,L,NC]
RewriteRule ^History\.html$ admin/index.php?page=history [R=302,L,NC]
RewriteRule ^Staff\.html$ admin/index.php?page=staff [R=302,L,NC]
RewriteRule ^Shifts\.html$ admin/index.php?page=shifts [R=302,L,NC]
RewriteRule ^Warehouse\.html$ admin/index.php?page=warehouse [R=302,L,NC]
RewriteRule ^Ops\.html$ admin/index.php?page=ops [R=302,L,NC]
RewriteRule ^Logs\.html$ admin/index.php?page=logs [R=302,L,NC]
RewriteRule ^Table\.html$ index.php?page=tables [R=302,L,NC]
RewriteRule ^Schedule\.html$ index.php?page=schedule [R=302,L,NC]
RewriteRule ^Orders\.html$ index.php?page=orders [R=302,L,NC]
RewriteRule ^Shift\.html$ index.php?page=cashshift [R=302,L,NC]
RewriteRule ^Kitchen\.html$ index.php?page=kitchen [R=302,L,NC]
